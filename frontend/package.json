{
  "name": "pulse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p worker && vite build",
    "preview": "vite preview",
    "dev:api": "npm run build && node scripts/db.mjs migrate dev && node scripts/dev-api.mjs",
    "deploy": "npm run build && npx --yes wrangler@4 deploy",
    "db:migrate": "node scripts/db.mjs migrate main",
    "demo:seed": "node scripts/demo-data.mjs seed > demo-data.sql && node scripts/db.mjs exec main demo-data.sql",
    "demo:remove": "node scripts/demo-data.mjs remove > demo-data.sql && node scripts/db.mjs exec main demo-data.sql",
    "db:migrate:dev": "node scripts/db.mjs migrate dev",
    "db:status": "node scripts/db.mjs status main",
    "db:backup": "node scripts/db.mjs backup main",
    "test": "vitest run"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@xyflow/react": "12.3.6",
    "lucide-react": "0.460.0",
    "postgres": "3.4.5",
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^3.2.4"
  }
}
