// Cloudflare deployment: one Worker serves the Vite build (assets) and the /api backend,
// backed by the D1 database. Deploy with `npm run deploy` (builds, migrates, deploys).
{
  "name": "omni-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omni-tracker",
      "database_id": "773ffacb-e945-4355-a516-510a55be2cfb",
      "migrations_dir": "migrations"
    }
  ]
}
