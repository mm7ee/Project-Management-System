// Pulse's app Worker, reached through the "pulse" Worker (gateway/). Keep this name: the MFA_KEY secret
// lives here and can't be read back to move it. One Worker serves the Vite build (assets) and the /api backend,
// backed by the D1 database. Deploy with `npm run deploy`; apply schema changes with
// `npm run db:migrate` (remote D1) before deploying code that depends on them.
{
  "name": "omni-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers AI, for Ask Pulse. Calls are billed to the account (a generous free daily allowance).
  "ai": { "binding": "AI" },
  // Pulse's address, for links in emails and Teams posts. Update it if the address ever changes.
  "vars": { "PUBLIC_URL": "https://pulse.utsa--wanza--ortfolio.workers.dev" },
  // In UTC; Harare is two hours ahead. Daily digests at 07:00 on weekdays, the Monday Briefing at 08:00.
  // BRIEFING_CRON in worker/index.ts must match the Monday entry.
  "triggers": { "crons": ["0 5 * * MON-FRI", "0 6 * * MON"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omni-tracker",
      "database_id": "773ffacb-e945-4355-a516-510a55be2cfb",
      "migrations_dir": "migrations"
    }
  ]
}
